# Environment Configuration Template

# Development Environment
DEV_BASE_URL=https://practice.expandtesting.com
DEV_LOG_LEVEL=debug

# QA Environment
QA_BASE_URL=https://practice.expandtesting.com
QA_LOG_LEVEL=info

# Staging Environment
STAGING_BASE_URL=https://practice.expandtesting.com
STAGING_LOG_LEVEL=info

# Production Environment
PROD_BASE_URL=https://practice.expandtesting.com
PROD_LOG_LEVEL=error

# Current Environment (dev, qa, staging, prod)
ENV=dev

# Test Credentials
TEST_USER_EMAIL=practice@expandtesting.com
TEST_USER_PASSWORD=practice123

# API Rate Limiting
API_RETRY_ATTEMPTS=3
API_RETRY_DELAY_MS=1000

# Timeouts
API_REQUEST_TIMEOUT_MS=30000
TEST_TIMEOUT_MS=30000

# Parallel Execution
PTHREAD_WORKERS=4
