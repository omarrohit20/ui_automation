{
  "name": "ui_automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:qa": "npx playwright test tests/shippingLabel.spec.ts environment=qa",
    "test:stage": "npx playwright test tests/shippingLabel.spec.ts environment=stage",
    "test:api": "set \"ENV=dev\" && npx playwright test --config api-test.config.ts",
    "test:api:qa": "set \"ENV=qa\" && npx playwright test --config api-test.config.ts",
    "test:api:staging": "set \"ENV=staging\" && npx playwright test --config api-test.config.ts",
    "test:api:prod": "set \"ENV=prod\" && npx playwright test --config api-test.config.ts",
    "test:api:users": "set \"ENV=dev\" && npx playwright test --config api-test.config.ts tests/api/users.spec.ts",
    "test:api:notes": "set \"ENV=dev\" && npx playwright test --config api-test.config.ts tests/api/notes.spec.ts",
    "test:api:integration": "set \"ENV=dev\" && npx playwright test --config api-test.config.ts tests/api/integration.spec.ts",
    "test:api:smoke": "set \"ENV=dev\" && npx playwright test --config api-test.config.ts --grep @positive",
    "test:api:negative": "set \"ENV=dev\" && npx playwright test --config api-test.config.ts --grep @negative",
    "test:api:debug": "set \"ENV=dev\" && npx playwright test --config api-test.config.ts --debug",
    "test:api:ui": "ENV=dev playwright test --config api-test.config.ts --ui",
    "report": "playwright show-report api-test-results/html",
    "perf:k6": "k6 run k6/scripts/notes-api-load-test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.0.0",
    "dotenv": "^16.6.1",
    "playwright-ctrf-json-reporter": "^0.0.27",
    "zaproxy": "^2.0.0-rc.6"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.1"
  }
}
